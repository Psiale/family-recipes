{
  "expo": {
    "name": "Recetario Familiar",
    "slug": "family-recipe-tree",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "familyrecipes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familyrecipetree.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#EEF1FF"
      },
      "package": "com.familyrecipetree.app",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF1FF",
          "dark": {
            "backgroundColor": "#EEF1FF"
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": []
        }
      ],
      "react-native-blob-util",
      "@kesha-antonov/react-native-background-downloader",
      "expo-asset",
      "expo-video"
    ],
    "locales": {
      "en": "./locales/app-en.json",
      "es": "./locales/app-es.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "63901f79-2a64-4b77-a025-3d17c456a54e"
      }
    },
    "owner": "psiale"
  }
}
