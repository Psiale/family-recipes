# Expo embeds only EXPO_PUBLIC_* values in the application bundle.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Server-only: use these only with the local database scripts or protected CI secrets.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPER_ADMIN_EMAIL=
